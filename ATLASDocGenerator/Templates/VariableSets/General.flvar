  <Variable
    Name="dispositif"
    Comment=""
    EvaluatedDefinition="sthemO 301">sthemO 301</Variable>
  <Variable
    Name="dispositif"
    Comment=""
    EvaluatedDefinition="STA Coag Expert">STA Coag Expert</Variable>
  <Variable
    Name="dispositif"
    Comment=""
