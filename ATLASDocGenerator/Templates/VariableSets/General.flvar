<?xml version="1.0" encoding="utf-8"?>
<CatapultVariableSet
  conditions="Stago_Gestion.Contenu commun">
  <Variable
    Name="Indice"
    OriginalName="VersionNumberDot"
    EvaluatedDefinition="Y"
    Comment="Indice majeur du document (format : N (ex : 1))">Y</Variable>
  <Variable
    Name="DocumentReference"
    Comment="ref du document (ex : 512345)"
    EvaluatedDefinition="5xxxxx">5xxxxx</Variable>
  <Variable
    Name="DocumentLanguage"
    Comment="Code langue"
    EvaluatedDefinition="FR">FR</Variable>
  <Variable
    Name="Version Interne"
    Comment="Indice mineur du document (à incrémenter après chaque validation pour le même indice majeur)"
    EvaluatedDefinition="0">0</Variable>
  <Variable
    Name="Copyright_DateLancement"
    Comment="Année du lancement/première version validée du manuel"
    EvaluatedDefinition="© 20XX">© 20XX</Variable>
  <Variable
    Name="GuideType"
    Comment=""
    EvaluatedDefinition="Manuel de référence">Manuel de référence</Variable>
  <Variable
    Name="dispositif"
    EvaluatedDefinition="Nom du dispositif"
    Comment="instrument (ou autre) concerné par le document">Nom du dispositif</Variable>
  <Variable
    Name="LegalCompanyName"
    Comment=""
    EvaluatedDefinition="Diagnostica Stago">Diagnostica Stago</Variable>
  <Variable
    Name="BrandCompany"
    Comment=""
    EvaluatedDefinition="Stago">Stago</Variable>
  <Variable
    Name="Liste des tubes bouchés"
    Comment="301 = 522311_x  201 = 525876_x Tubes bouchés sthemO à modifier dans la target"
    EvaluatedDefinition="522311_x">522311_x</Variable>
  <Variable
    Name="Liste reactifs Microcups"
    Comment="301 = 527604_x   201 = 528863_x Liste des réactifs utilisables en Microcups"
    EvaluatedDefinition="527604_x">527604_x</Variable>
  <Variable
    Name="dispositif"
    Comment=""
    EvaluatedDefinition="sthemO 201">sthemO 201</Variable>
  <Variable
    Name="Liste reactifs Microcups"
    Comment="pour 201"
    EvaluatedDefinition="528863_x">528863_x</Variable>
  <Variable
    Name="Liste des tubes bouchés"
    Comment="pour 201"
    EvaluatedDefinition="525876_x">525876_x</Variable>
  <Variable
    Name="DocumentReference"
    Comment="pour 201"
    EvaluatedDefinition="516763">516763</Variable>
  <Variable
    Name="dispositif"
    Comment=""
    EvaluatedDefinition="STA R Max®">STA R Max®</Variable>
  <Variable
    Name="dispositif"
    Comment=""
    EvaluatedDefinition="STA Compact Max®">STA Compact Max®</Variable>
  <Variable
    Name="GuideType"
    Comment=""
    EvaluatedDefinition="Addenda au manuel de référence">Addenda au manuel de référence</Variable>
  <Variable
    Name="GuideType"
    Comment=""
    EvaluatedDefinition="Autre">Autre</Variable>
  <Variable
    Name="Copyright_DateEdition"
    Comment=""
    EvaluatedDefinition="MM/YYYY">MM/YYYY</Variable>
  <Variable
    Name="HTML_Reference"
    Comment=""
    EvaluatedDefinition="sthemO 301_UD_001_3_DRAFT">sthemO 301_UD_001_3_DRAFT</Variable>
  <Variable
    Name="HTMLTitle"
    Comment=""
