<?xml version="1.0" encoding="utf-8"?>
<html xmlns:MadCap="http://www.madcapsoftware.com/Schemas/MadCap.xsd" MadCap:conditions="Stago_Gestion.Contenu commun">
    <head>
        <link href="../../TableStyles/Tableau_classique.css" rel="stylesheet" MadCap:stylesheetType="table" />
    </head>
    <body>
        <table style="width: 100%;mc-table-style: url('../../TableStyles/Tableau_classique.css');margin-left: auto;margin-right: auto;" class="TableStyle-Tableau_classique" cellspacing="0">
            <col class="TableStyle-Tableau_classique-Column-Column1" style="width: 80px;" />
            <col class="TableStyle-Tableau_classique-Column-Column1" />
            <col class="TableStyle-Tableau_classique-Column-Column1" style="width: 80px;" />
            <col class="TableStyle-Tableau_classique-Column-Column1" />
            <thead>
                <tr class="TableStyle-Tableau_classique-Head-Header1">
                    <th class="TableStyle-Tableau_classique-HeadE-Column1-Header1">Symbole</th>
                    <th class="TableStyle-Tableau_classique-HeadE-Column1-Header1">Signification</th>
                    <th class="TableStyle-Tableau_classique-HeadE-Column1-Header1">Symbole</th>
                    <th class="TableStyle-Tableau_classique-HeadD-Column1-Header1">Signification</th>
                </tr>
            </thead>
            <tbody>
                <tr class="TableStyle-Tableau_classique-Body-Body1">
                    <td class="TableStyle-Tableau_classique-BodyE-Column1-Body1">
                        <p class="setup_symbole_attention">&#160;</p>
                    </td>
                    <td class="TableStyle-Tableau_classique-BodyE-Column1-Body1">
                        <MadCap:snippetBlock src="Attention_signification.flsnp" />
                    </td>
                    <td class="TableStyle-Tableau_classique-BodyE-Column1-Body1">
                        <p class="setup_symbole_precau">&#160;</p>
                    </td>
                    <td class="TableStyle-Tableau_classique-BodyD-Column1-Body1">
                        <MadCap:snippetBlock src="Precau_signification.flsnp" />
                    </td>
                </tr>
                <tr class="TableStyle-Tableau_classique-Body-Body1">
                    <td class="TableStyle-Tableau_classique-BodyE-Column1-Body1">
                        <p class="setup_symbole_info">&#160;</p>
                    </td>
                    <td class="TableStyle-Tableau_classique-BodyE-Column1-Body1">
                        <MadCap:snippetBlock src="Info_signification.flsnp" />
                    </td>
                    <td class="TableStyle-Tableau_classique-BodyE-Column1-Body1">
                        <p>
                            <MadCap:snippetText src="Fig.flsnp" />
                        </p>
                    </td>
                    <td class="TableStyle-Tableau_classique-BodyD-Column1-Body1">
                        <MadCap:snippetBlock src="Fig_signification.flsnp" />
                    </td>
                </tr>
                <tr class="TableStyle-Tableau_classique-Body-Body1">
                    <td class="TableStyle-Tableau_classique-BodyB-Column1-Body1">
                        <p>[<MadCap:snippetText src="Texte.flsnp" />]</p>
                    </td>
                    <td class="TableStyle-Tableau_classique-BodyB-Column1-Body1">
                        <MadCap:snippetBlock src="Texte_entre_crochets.flsnp" />
                    </td>
                    <td class="TableStyle-Tableau_classique-BodyB-Column1-Body1">/</td>
                    <td class="TableStyle-Tableau_classique-BodyA-Column1-Body1">/</td>
                </tr>
            </tbody>
        </table>
    </body>
</html>